# =======================================================
# Intelligent Land Record Digitization & Validation System
# SIH 2026 Environment Configuration
# =======================================================

# Server Configuration
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local SQLite fallback for zero-dependency test runs:
DATABASE_URL=sqlite+aiosqlite:///land_intel.db
# PostgreSQL + PostGIS (Production/Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/land_intel_db

# Security & Authentication
SECRET_KEY=sih2026-intelligent-land-record-super-secret-key-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Object Storage (MinIO / S3)
STORAGE_TYPE=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=land-records

# Redis Queue
REDIS_URL=redis://localhost:6379/0

# AI & OCR Engine Configuration
OCR_PROVIDER=hybrid
AI_PROVIDER=rule_ml
SUPPORTED_LANGUAGES=["en", "ta", "hi"]

# Cadastral Validation Engine Defaults
AREA_TOLERANCE_PERCENT=5.0
OCR_CONFIDENCE_THRESHOLD=75.0
HIGH_RISK_THRESHOLD=65.0

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
